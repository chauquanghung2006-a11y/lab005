        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\n // 1. Kiểm tra xem hệ thống có trả về đúng mã 201 Created không\r\npm.test(\"Tạo User thành công (Status 201)\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\n// 2. Bóc tách dữ liệu JSON do máy chủ trả về\r\nvar jsonData = pm.response.json();\r\n\r\n// 3. Trích xuất id của user đó và lưu vào biến môi trường\r\nif (jsonData.id) {\r\n    pm.environment.set(\"userId\", jsonData.id);\r\n    console.log(\"Đã lưu User ID: \" + jsonData.id);\r\n}\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"Hung Test New\",\r\n  \"gender\": \"male\",\r\n  \"email\": \"hung.{{$randomInt}}@example.com\",\r\n  \"status\": \"active\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseurl}}/public/v2/users",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
